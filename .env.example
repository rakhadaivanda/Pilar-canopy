# Port server auth (default 3001)
PORT=3001

# Secret untuk cookie sesi login (ganti di production)
SESSION_SECRET=ganti-dengan-string-acak-panjang

# Secret bersama SSO ke ERP (harus sama dengan ERP backend)
SSO_SHARED_SECRET=ganti-dengan-secret-ss0-sama-dengan-erp
# URL login ERP tujuan SSO
ERP_SSO_URL=https://erp.canopy.rezekibarokahjaya.net/login

# Akun login statis (login tidak memakai Google Sheet)
ADMIN_USERNAME=SuperAdmin
ADMIN_PASSWORD=ganti-dengan-password-login

# ID Google Spreadsheet untuk CMS (bukan login)
SHEET_ID=19HbZQ3iHpQJve1Lcev_lsp3y6ohKZ3kRwjxbKdXptYA

# Kredensial service account.
# Boleh isi JSON mentah atau base64 dari file key.
# Alternatif: taruh file key di /var/www/pillar-canopy-5d25712dd970.json
# GOOGLE_SERVICE_ACCOUNT_JSON=
